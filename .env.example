# Copy to .env and fill in.  Everything here has a working dev default except
# the two Canvas credentials.

# --- Django -----------------------------------------------------------------
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://ldrbrd.example.edu
# DJANGO_DB_PATH=/var/lib/ldrbrd/db.sqlite3
# DJANGO_TIME_ZONE=America/New_York

# Public base URL of this deployment.  Used to build course join links, the
# data URLs handed to students, and the default OIDC discovery URL below.
LDRBRD_BASE_URL=http://localhost:8000

# --- Canvas -----------------------------------------------------------------
# Your Canvas instance.
CANVAS_BASE_URL=https://canvas.instructure.com

# From a Canvas developer key (Admin > Developer Keys > + API Key).
# Set its redirect URI to:  <LDRBRD_BASE_URL>/accounts/oidc/canvas/login/callback/
CANVAS_CLIENT_ID=
CANVAS_CLIENT_SECRET=

# Canvas publishes no OIDC discovery document, so Ldrbrd serves its own at
# /.well-known/canvas-openid-configuration.  Override this only if the app
# cannot reach LDRBRD_BASE_URL from inside its own network (containers,
# reverse proxies) -- point it at the loopback address instead:
# CANVAS_OIDC_DISCOVERY_URL=http://127.0.0.1:8000/.well-known/canvas-openid-configuration

# The django-allauth fork's escape hatch: JSON merged *over* the discovery
# document above.  Use it to repoint a single endpoint without a redeploy.
# CANVAS_OPENID_CONFIG_OVERRIDES={"token_endpoint":"https://proxy.example.edu/login/oauth2/token"}

# Leave empty when your developer key does NOT enforce scopes (the common
# case).  If it does, Ldrbrd needs to read the signed-in user:
# CANVAS_OAUTH_SCOPE=url:GET|/api/v1/users/:id
CANVAS_OAUTH_SCOPE=

# Canvas does not support PKCE on OAuth2 developer keys; leave this off unless
# you are pointing at something that does.
CANVAS_OAUTH_PKCE=false

# Keep Canvas access/refresh tokens in the database (only needed if you later
# want to call the Canvas API on a user's behalf).
CANVAS_STORE_TOKENS=false

# --- Ldrbrd -----------------------------------------------------------------
# Largest JSON document a single app may store, in bytes.
LDRBRD_MAX_PAYLOAD_BYTES=1048576
